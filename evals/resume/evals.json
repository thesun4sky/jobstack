    {
      "query": "ATS 키워드 매칭 좀 봐줘, 공고 붙여넣을게",
      "expect": true
    },
    {
      "query": "이 회사 맞춤으로 이력서 다듬고 싶어요",
      "expect": true
    },
    {
      "query": "경력기술서 작성해줘",
      "expect": false
    },
    {
      "query": "자기소개서 첨삭해줘",
      "expect": false
    },
    {
