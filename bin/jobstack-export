#!/usr/bin/env bash
# jobstack-export — 첨삭 완료 마크다운을 제출용 .docx로 변환 (ATS-safe)
#
# 사용법: jobstack-export <입력.md> [출력.docx]
#   출력 생략 시 입력 파일명의 확장자만 .docx로 교체
#
# 종료 코드:
#   0 — 변환 성공 (stdout에 산출 파일 절대경로 출력)
#   1 — 입력 오류 (파일 없음 등)
#   2 — pandoc과 Node docx 폴백 둘 다 사용 불가 (호출 스킬은 md 복붙 폴백으로 전환)
#   3 — 변환 실패 (호출 스킬은 md 복붙 폴백으로 전환)
#   4 — 미확인 placeholder 잔존 (markdown 복붙 폴백 금지 — 항목 보완 후 재시도)
#
# 변환 경로 (U-13 이중화 — pandoc 부재/구버전 환경에서도 ATS-safe .docx 산출):
#   pandoc ≥ 3.6 설치        → 기존 pandoc 경로(--reference-doc=ats-reference.docx)
#   pandoc < 3.6 설치        → stderr 경고 후 Node 폴백(JOBSTACK_EXPORT_FORCE_PANDOC=1이면
#                               경고만 내고 pandoc을 그대로 사용)
#   pandoc 미설치            → Node 폴백(bin/md2docx.mjs + bin/node_modules/docx)
#   pandoc도 docx 패키지도 없음 → exit 2 (brew install pandoc 또는 cd bin && npm install 안내)
# Node 폴백은 표를 문단으로 풀어 쓴다(표·이미지·텍스트박스 없는 ATS-safe 산출 유지 — 헤더 행은 굵게).
# 폴백 스크립트 경로는 JOBSTACK_MD2DOCX 환경변수로 재정의할 수 있다(테스트용).
#
# 환경 분기 (docs 참조): jobclaw 봇 워크스페이스에서는 File output protocol
# ([OUTPUT_FILE:] + render-docx.sh)이 docx 산출을 담당한다. 이 유틸은
# render-docx.sh가 없는 독립 CLI 환경의 경로다.
#
# ATS-safe: templates/export/ats-reference.docx 기준 — 표·이미지·텍스트박스 없는
# 단일 컬럼, 표준 제목 스타일, 본문 11pt, Noto Sans KR(Council #1 Q5 — 로컬에
# 폰트가 없으면 시스템 한글 폰트로 대체 렌더링됨).
#
# ats-reference.docx 재생성 절차(pandoc ≥ 3.6 필요 — 이 저장소 환경엔 pandoc이 없어 미실행):
#   pandoc -o custom-reference.docx --print-default-data-file reference.docx 실행 후 스타일 편집.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REFERENCE="$SCRIPT_DIR/../templates/export/ats-reference.docx"

# 산출물 검증 — 비어 있지 않고 zip(.docx) 으로 열리며 word/document.xml 이 있는지 확인한다
# (PR #17 리뷰 반영: 변환기가 exit 0 을 내고도 파일을 만들지 않은 경우를 "성공" 으로 보고했다).
# python3 이 없는 PATH 에서는 존재·크기 검사만 한다.
verify_docx() {
  [ -s "$1" ] || return 1
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys, zipfile
try:
    with zipfile.ZipFile(sys.argv[1]) as z:
        sys.exit(0 if "word/document.xml" in z.namelist() else 1)
except Exception:
    sys.exit(1)' "$1"
  else
    return 0
  fi
}

IN="${1:-}"
if [ -z "$IN" ] || [ ! -f "$IN" ]; then
  echo "사용법: jobstack-export <입력.md> [출력.docx]" >&2
  [ -n "$IN" ] && echo "입력 파일을 찾을 수 없습니다: $IN" >&2
  exit 1
fi

OUT="${2:-${IN%.md}.docx}"

# 절대경로로 출력 (성공 경로 공용 — pandoc/Node 폴백 어느 쪽이든 동일하게 사용).
print_abs_path() {
  case "$1" in
    /*) echo "$1" ;;
    *)  echo "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")" ;;
  esac
}

# 가드레일: 미확인 placeholder가 남은 채로 제출용 파일이 나가지 않도록 차단.
# pandoc 존재 여부와 무관하게 **가장 먼저** 검사한다 — pandoc 미설치 환경에서도
# 미확인 정보가 그대로 제출되지 않도록 한다.
# exit 4 = "placeholder 미보완" 전용 코드. 호출 스킬은 exit 4를 markdown 복붙 폴백
# 대상에서 제외하고, 남은 항목을 사용자에게 채우도록 요청해야 한다(fallback 금지).
# (templates/guardrails.md §1 — 미확인 정보는 placeholder로 유지하되 제출 전 채워야 함)
PLACEHOLDERS=$(grep -nE '\[[^]]*(확인 필요|입력 필요|추정)[^]]*\]' "$IN" || true)
if [ -n "$PLACEHOLDERS" ]; then
  echo "차단: 미확인 placeholder가 남아 있어 변환하지 않습니다 — 아래 항목을 먼저 채우세요:" >&2
  while IFS= read -r pl_line; do echo "  $pl_line" >&2; done <<<"$PLACEHOLDERS"
  echo "(이 파일은 markdown 복붙 폴백 대상이 아닙니다 — 항목을 채운 뒤 다시 시도하세요)" >&2
  exit 4
fi

# ATS 경고: 입력에 마크다운 표가 있으면(pandoc 경로에서는 표 그대로, Node 폴백에서는 문단으로
# 풀려 들어간다) ATS 파서 호환을 위해 목록 형식 전환을 권장한다.
if grep -qE '^\|.*\|' "$IN"; then
  echo "경고: 입력에 표가 있습니다 — ATS 파서가 표 내용을 누락할 수 있으니 목록 형식 전환을 권장합니다" >&2
fi

# ── pandoc 탐지 + 버전 판정 (bash 정규식·파라미터 확장만 사용 — head/sed 등 외부 유틸
# 없이 bash 3.2(macOS 기본)·BSD 유틸 환경에서도 동일하게 동작한다) ──
PANDOC_MAJOR=0
PANDOC_MINOR=0
HAVE_PANDOC=0
if command -v pandoc >/dev/null 2>&1; then
  HAVE_PANDOC=1
  PANDOC_VER_FULL="$(pandoc --version 2>/dev/null)"
  PANDOC_VER_LINE="${PANDOC_VER_FULL%%$'\n'*}"   # head -1 대용(첫 줄만)
  if [[ "$PANDOC_VER_LINE" =~ ([0-9]+)\.([0-9]+) ]]; then
    PANDOC_MAJOR="${BASH_REMATCH[1]}"
    PANDOC_MINOR="${BASH_REMATCH[2]}"
  fi
fi

pandoc_new_enough() {
  [ "$PANDOC_MAJOR" -gt 3 ] && return 0
  [ "$PANDOC_MAJOR" -eq 3 ] && [ "$PANDOC_MINOR" -ge 6 ] && return 0
  return 1
}

USE_PANDOC=0
if [ "$HAVE_PANDOC" -eq 1 ]; then
  if pandoc_new_enough; then
    USE_PANDOC=1
  else
    echo "경고: pandoc ${PANDOC_MAJOR}.${PANDOC_MINOR} < 3.6 — ats-reference.docx 호환을 보장하지 않아 Node 폴백을 사용" >&2
    if [ "${JOBSTACK_EXPORT_FORCE_PANDOC:-}" = "1" ]; then
      USE_PANDOC=1
    fi
  fi
fi

if [ "$USE_PANDOC" -eq 1 ]; then
  # ── 기존 pandoc 경로 ──
  if [ ! -f "$REFERENCE" ]; then
    echo "경고: ATS 레퍼런스 템플릿 없음($REFERENCE) — pandoc 기본 스타일로 변환합니다" >&2
    REF_ARGS=()
  else
    REF_ARGS=(--reference-doc="$REFERENCE")
  fi

  if pandoc "$IN" -o "$OUT" "${REF_ARGS[@]+"${REF_ARGS[@]}"}" 2>/dev/null && [ -s "$OUT" ]; then
    print_abs_path "$OUT"
    exit 0
  else
    echo "변환 실패 — 마크다운 문법을 확인하거나 내용을 문서 앱에 복사해 저장하세요" >&2
    exit 3
  fi
fi

# ── Node 폴백 경로 (pandoc 미설치, 또는 구버전이라 정책상 사용하지 않음) ──
NODE_SCRIPT="${JOBSTACK_MD2DOCX:-$SCRIPT_DIR/md2docx.mjs}"
echo "Node docx 폴백으로 변환(표는 문단으로 풀림)" >&2

NODE_STDERR="$(node "$NODE_SCRIPT" "$IN" "$OUT" 2>&1 >/dev/null)"
NODE_RC=$?

if [ "$NODE_RC" -eq 0 ]; then
  if verify_docx "$OUT"; then
    print_abs_path "$OUT"
    exit 0
  fi
  [ -n "$NODE_STDERR" ] && printf '%s\n' "$NODE_STDERR" >&2
  echo "변환기가 성공을 보고했지만 산출물이 없거나 유효한 .docx(zip) 가 아닙니다: $OUT" >&2
  echo "변환 실패 — 마크다운 내용을 문서 앱(Word/한글/Pages)에 복사해 저장하세요" >&2
  exit 3
fi

if [ "$NODE_RC" -eq 3 ] && printf '%s' "$NODE_STDERR" | grep -q 'docx' && printf '%s' "$NODE_STDERR" | grep -q '패키지'; then
  echo "pandoc·Node docx 폴백 둘 다 사용할 수 없어 .docx 변환을 건너뜁니다." >&2
  echo "  설치 후 재시도: brew install pandoc  (macOS, pandoc 경로)" >&2
  echo "  또는: cd bin && npm install  (Node docx 폴백 활성화)" >&2
  echo "  또는 마크다운 내용을 문서 앱(Word/한글/Pages)에 복사해 저장하세요." >&2
  exit 2
fi

[ -n "$NODE_STDERR" ] && printf '%s\n' "$NODE_STDERR" >&2
echo "변환 실패 — 마크다운 문법을 확인하거나 내용을 문서 앱에 복사해 저장하세요" >&2
exit 3
